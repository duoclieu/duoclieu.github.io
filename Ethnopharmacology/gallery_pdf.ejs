<style>
.pdf-frame {
  margin-bottom: 2rem;
  text-align: center;
}
</style>

<% for (const item of items) { %>
<div style="width: 100%; height: 800px; margin-bottom: 2rem;">
  <iframe src="<%= item.path %>" style="width: 100%; height: 100%; border: none;"></iframe>
  <div style="text-align: center; margin-top: 0.5rem;"><%= item.name %></div>
</div>
<% } %>
